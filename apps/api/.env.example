# ---------------------------------------------------------------------------
# Circula API — copie este arquivo para `.env` e ajuste os valores.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# O arquivo `.env` está no .gitignore e NUNCA deve ser commitado.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Porta do servidor HTTP local.
# (evitamos 3333 de propósito: é a porta padrão de muitos projetos Node)
PORT=4000

# Origens autorizadas no CORS, separadas por vírgula (sem barra no final).
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Sprint 1 -------------------------------------------------------------
# String de conexão do PostgreSQL (Neon). Ex.:
# DATABASE_URL="postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/circula?sslmode=require"

# --- Sprint 2 -------------------------------------------------------------
# Segredo de assinatura do JWT. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
